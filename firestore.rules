rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId));
    }

    function isMember(tripId) {
      return signedIn()
        && request.auth.uid in tripDoc(tripId).data.memberIds;
    }

    function isOwner(tripId) {
      return signedIn()
        && tripDoc(tripId).data.ownerId == request.auth.uid;
    }

    function validJoin(tripId) {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt', 'updatedBy'])
        && (!('bannedMemberIds' in resource.data) || !(request.auth.uid in resource.data.bannedMemberIds))
        && resource.data.inviteCode != null
        && exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode))
        && get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.tripId == tripId;
    }

    function memberSafeUpdate() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.members == resource.data.members
        && request.resource.data.inviteCode == resource.data.inviteCode;
    }

    function validLeave() {
      return signedIn()
        && request.auth.uid != resource.data.ownerId
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && !request.resource.data.members.keys().hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt', 'updatedBy']);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.inviteCode == code;
      allow update, delete: if false;
    }

    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow read: if isMember(tripId);
      allow update: if (isOwner(tripId))
        || (isMember(tripId) && memberSafeUpdate())
        || validJoin(tripId)
        || validLeave();
      allow delete: if isOwner(tripId);

      match /{subcollection}/{docId} {
        allow read, write: if isMember(tripId);
      }
    }
  }
}
